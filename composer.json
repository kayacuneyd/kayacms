{
    "name": "kayacms/kayacms",
    "description": "KayaCMS — a modular headless CMS built on CodeIgniter 4, with theme engine, RBAC, media queue, REST API and an admin panel.",
    "license": "MIT",
    "type": "project",
    "keywords": ["cms", "headless", "codeigniter4", "content-management", "php"],
    "homepage": "https://github.com/kayacuneyd/kayacms",
    "authors": [
        {
            "name": "KayaCMS contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/kayacuneyd/kayacms/issues",
        "source": "https://github.com/kayacuneyd/kayacms"
    },
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/",
            "Content\\": "modules/Content/",
            "Taxonomy\\": "modules/Taxonomy/",
            "Media\\": "modules/Media/",
            "User\\": "modules/User/",
            "Menu\\": "modules/Menu/",
            "Setting\\": "modules/Setting/",
            "Theme\\": "modules/Theme/",
            "Contact\\": "modules/Contact/",
            "Maintenance\\": "modules/Maintenance/",
            "Newsletter\\": "modules/Newsletter/",
            "Rss\\": "modules/Rss/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php -l app/ modules/"
    }
}